{
  "name": "ring-mcp",
  "version": "1.0.1",
  "description": "Ring Security Ecosystem MCP - Universal control for Ring doorbell, burglar alarm, fire alarm, and cameras",
  "author": "Sandra",
  "license": "MIT",
  "mcp": {
    "version": "2.12.0",
    "server": {
      "command": "python",
      "args": ["-m", "ring_mcp"],
      "transport": "stdio"
    },
    "capabilities": {
      "tools": true
    }
  },
  "dependencies": {
    "python": ">=3.9",
    "fastmcp": ">=2.12.0",
    "ring-doorbell": ">=0.9.0",
    "httpx": ">=0.25.0",
    "pydantic": ">=2.0.0",
    "python-dotenv": ">=1.0.0",
    "asyncio-throttle": ">=1.0.0",
    "python-jose": ">=3.3.0",
    "aiocache": ">=0.12.0",
    "tenacity": ">=8.2.0",
    "uvicorn": ">=0.23.0",
    "python-json-logger": ">=2.0.0"
  },
  "build": {
    "source_dir": "ring_mcp",
    "output_dir": "dist",
    "include_patterns": [
      "ring_mcp/**/*.py",
      "mcpb/prompts/**/*.json",
      "requirements.txt",
      "README.md",
      "CHANGELOG.md"
    ],
    "exclude_patterns": [
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.git/**",
      "**/tests/**",
      "**/*.log"
    ]
  },
  "metadata": {
    "homepage": "https://github.com/ring-mcp/ring-mcp",
    "repository": "https://github.com/ring-mcp/ring-mcp",
    "documentation": "https://github.com/ring-mcp/ring-mcp/blob/main/README.md",
    "keywords": [
      "ring",
      "security",
      "cameras",
      "doorbells",
      "mcp",
      "fastmcp",
      "monitoring",
      "automation",
      "home-security"
    ]
  }
}
