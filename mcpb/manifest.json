{
  "name": "ring-mcp",
  "version": "1.0.1",
  "description": "Universal Ring Security Ecosystem Control - Comprehensive MCP server for Ring doorbells, security cameras, and alarm systems with Austrian precision",
  "author": "Sandra",
  "license": "MIT",
  "homepage": "https://github.com/sandraschi/ring-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/ring-mcp"
  },
  "main": "server/server.py",
  "mcp": {
    "version": "1.0",
    "capabilities": ["tools"],
    "prompts": {
      "system": "assets/prompts/system.md",
      "device_management": "assets/prompts/device_management.md",
      "security_monitoring": "assets/prompts/security_monitoring.md",
      "automation_workflows": "assets/prompts/automation_workflows.md",
      "event_handling": "assets/prompts/event_handling.md",
      "troubleshooting": "assets/prompts/troubleshooting.md"
    }
  },
  "runtime": {
    "python": ">=3.10"
  },
  "dependencies": {
    "fastmcp": ">=2.12.0",
    "ring-doorbell": ">=0.8.0",
    "pydantic": ">=2.0.0",
    "httpx": ">=0.27.0"
  },
  "features": [
    "Unified Ring device API (doorbells, cameras, alarms)",
    "Real-time event monitoring with WebSocket",
    "Live video streaming access",
    "Motion and doorbell event detection",
    "Health monitoring and diagnostics",
    "Device status and battery monitoring",
    "Light and siren control",
    "Snapshot capture",
    "Secure token storage with auto-refresh",
    "Docker containerization support",
    "Redis caching and session management",
    "Grafana monitoring dashboards",
    "Structured JSON logging with Loki",
    "Multi-server monitoring support",
    "Austrian engineering quality"
  ],
  "supported_devices": [
    "Ring Video Doorbell (all models)",
    "Ring Stick Up Cam",
    "Ring Spotlight Cam",
    "Ring Floodlight Cam",
    "Ring Indoor Cam",
    "Ring Alarm (base station, sensors)",
    "Ring Chime and Chime Pro"
  ],
  "security": {
    "authentication": "Ring account with 2FA recommended",
    "token_storage": "Encrypted token storage",
    "token_refresh": "Automatic refresh handling",
    "communication": "HTTPS encrypted API calls",
    "audit": "All device operations logged"
  },
  "keywords": [
    "ring",
    "security",
    "cameras",
    "doorbells",
    "alarm",
    "monitoring",
    "automation",
    "home-security",
    "iot",
    "smart-home",
    "surveillance",
    "fastmcp",
    "austria"
  ]
}

