# Ring Account Credentials
# Required for authentication with the Ring API
RING_USERNAME=your_ring_email@example.com
RING_PASSWORD=your_ring_password

# Optional: If you have an existing OAuth token
# RING_TOKEN=your_ring_oauth_token

# Server Configuration
HOST=0.0.0.0
PORT=10729
LOG_LEVEL=INFO

# Browser / tooling: base URL of the Ring HTTP API (no trailing slash). web_sota defaults to this.
RING_HTTP_API_ORIGIN=http://127.0.0.1:10729

# Optional: Ring Alarm (base station) via ring-mqtt + MQTT (https://github.com/tsightler/ring-mqtt)
# Run ring-mqtt against the same broker; default topic prefix is "ring" (ring/<location>/alarm/<id>/alarm/state).
# RING_MQTT_ENABLED=1
# RING_MQTT_URL=mqtt://127.0.0.1:1883
# RING_MQTT_USERNAME=
# RING_MQTT_PASSWORD=
# RING_MQTT_TOPIC_PREFIX=ring
# RING_MQTT_CLIENT_ID=ring-mcp-bridge

# Cache Configuration (in seconds)
CACHE_TTL=300

# Rate Limiting
RATE_LIMIT=10  # Requests per minute

# Development Settings
DEBUG=False

# MCP Bridge: comma-separated URLs of remote MCP servers to proxy
# MCP_BRIDGE_URLS=http://127.0.0.1:10750/mcp,http://127.0.0.1:10752/mcp

# Optional: Redis Configuration for distributed caching
# REDIS_URL=redis://localhost:6379/0
