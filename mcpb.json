{
    "name": "ring-mcp",
    "version": "1.0.4",
    "type": "server",
    "runtime": "python",
    "entry_point": "ring_mcp/__main__.py",
    "dependencies": [
        "fastmcp>=3.4.4,<4",
        "ring-doorbell>=0.8.0"
    ],
    "build": {
        "include": [
            "ring_mcp/**/*",
            "README.md",
            "LICENSE"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/",
            "mcpb/"
        ]
    },
    "scripts": {
        "build": "mcpb build",
        "pack": "mcpb pack . dist/ring-mcp.mcpb",
        "test": "python -m pytest"
    }
}
