{
  "name": "ring-mcp-server",
  "version": "2.12.0",
  "description": "Ring Security System Management MCP Server - FastMCP 2.12",
  "author": "Ring MCP Development Team",
  "license": "MIT",
  "outputDir": "dist",
  "mcp": {
    "version": "2.12.0",
    "server": {
      "command": "python",
      "args": ["-m", "ring_mcp.server"],
      "transport": "stdio"
    },
    "capabilities": {
      "tools": true,
      "resources": true,
      "prompts": true
    }
  },
  "dependencies": {
    "python": ">=3.9.0"
  }
}
