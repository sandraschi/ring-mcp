{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": ["sandraschi"],
  "name": "ring-mcp",
  "description": "FastMCP 2.12 server for Ring device management including doorbells, security cameras, and alarm systems. Beta status.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 2.12",
  "tools": 12,
  "transport": ["stdio"],
  "keywords": [
    "ring",
    "security",
    "cameras",
    "doorbells",
    "alarm",
    "home-security",
    "mcp-server",
    "fastmcp",
    "iot"
  ],
  "features": {
    "device_management": {
      "enabled": true,
      "devices": ["doorbells", "cameras", "alarm_systems"]
    },
    "monitoring": {
      "enabled": true
    },
    "automation": {
      "enabled": true
    }
  }
}

